{
  "name": "chrome-extension-boilerplate",
  "version": "1.0.0",
  "description": "A Chrome extension for a custom new tab.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "tsc": "tsc --noEmit",
    "check": "yarn lint && yarn tsc",
    "build": "vite build && vite build --config vite.content.config.ts",
    "build:prod": "yarn check && yarn build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/chrome": "^0.0.279",
    "@types/node": "^22.7.7",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.3",
    "globals": "^15.11.0",
    "vite": "^5.4.9"
  },
  "packageManager": "yarn@4.2.2"
}
