{
  "manifest_version": 3,
  "name": "My Chrome Extension",
  "description": "A Chrome extension for a custom new tab.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
